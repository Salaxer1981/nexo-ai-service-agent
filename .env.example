# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# OpenRouter: embeddings (RAG) and the agent's chat model. The key is optional: without it /rag/search and /chat answer 503.
OPENROUTER_API_KEY=
# Chat model (default x-ai/grok-4.7, verified). No fallback model is ever used.
OPENROUTER_CHAT_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# RAG (embeddings only). Default model verified at 1536 dimensions. Leave empty for defaults.
RAG_EMBEDDING_MODEL=
# Relevance threshold (calibrated default 0.39; see evidence/10-rag/calibration.json)
RAG_MIN_SCORE=

# PostgreSQL (used by compose.yaml for both db and backend)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Synthetic assessment credentials: bearer tokens for CUSTOMER_A / CUSTOMER_B.
# Use random values of at least 32 characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN_CUSTOMER_A=
AUTH_TOKEN_CUSTOMER_B=

# n8n (self-hosted). Random value, e.g. python -c "import secrets; print(secrets.token_hex(32))".
# Keep it stable: n8n encrypts stored credentials with it; changing it breaks an existing n8n_data volume.
N8N_ENCRYPTION_KEY=
# n8n UI host port, bound to 127.0.0.1 only (defaults to 5678 if empty)
N8N_HOST_PORT=

# n8n lead-writer service credential (APP-03B). Generate a random token, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Store the RAW token only in n8n (credential 'nexo-lead-writer', Header Auth: Authorization = Bearer <token>).
# Put ONLY its SHA-256 here, e.g. python -c "import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" <token>
LEAD_WRITER_TOKEN_SHA256=

# Backend host port, bound to 127.0.0.1 only (defaults to 8000 if empty)
BACKEND_PORT=

# Evaluation web client (UI-02), bound to 127.0.0.1 only (defaults to 8080 if empty). It uses AUTH_TOKEN_CUSTOMER_A/B above
# server-side to act as the two synthetic demo customers; the browser never receives them. Never use VITE_* variables for them.
WEB_PORT=
